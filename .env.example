VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Use a private/template-serving backend URL in production.
# If omitted, local development can read from public/acord-templates.
VITE_ACORD_TEMPLATE_BASE_URL=

# Supabase Edge Functions only. Do not expose these in Vite/client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CARRIER_VAULT_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Comma-separated production origins, for example:
# ALLOWED_ORIGINS=https://app.agencyiq.com,https://agencyiq.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep false in production unless you intentionally want simulated IVANS files.
ALLOW_IVANS_DEMO_MODE=false
